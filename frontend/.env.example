# SkyCare — environment template (frontend/)
#
# Copy to `.env.local` and fill in real values.
#   cp .env.example .env.local
# Every NEXT_PUBLIC_* variable is inlined into the client bundle at build time.
# The two Supabase keys + service role key are mandatory; the rest are optional
# feature toggles (Paystack online payments, web push, custom branding).

# ── Supabase (mandatory) ─────────────────────────────────────────────────────
# Project URL / anon key / service-role key from
#   Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ── Tenancy routing (mandatory) ──────────────────────────────────────────────
# Parent domain that tenant subdomains hang off: <slug>.skycare.app in prod.
# The local test domain is only used by `tenant-link`/cookie scoping when the
# request host does NOT end with ROOT_DOMAIN.
NEXT_PUBLIC_ROOT_DOMAIN=skycare.app
NEXT_PUBLIC_LOCAL_DOMAIN=skycare.test

# ── App URLs (optional) ──────────────────────────────────────────────────────
# Canonical origin of the app footprint. Falls back to the request origin when
# absent.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Paystack online payments (optional) ──────────────────────────────────────
# Real keys live per-tenant in `tenants.settings.paystack` via Settings → Online
# payments. These env values are the GLOBAL FALLBACK for development / the
# platform owner. Set the Paystack webhook URL to
#   https://<domain>/api/payments/webhook
# and configure the matching webhook secret so the HMAC check passes.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Web Push notifications (optional) ────────────────────────────────────────
# VAPID keypair: bundle `web-push generate-vapid-keys` into a `.env`-loaded
# generator, or use `npx web-push generate-vapid-keys --json`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BNxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_PRIVATE_KEY=<32-byte-private-key>
VAPID_SUBJECT=mailto:admin@example.com